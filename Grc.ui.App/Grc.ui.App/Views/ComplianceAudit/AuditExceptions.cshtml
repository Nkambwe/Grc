@model UserDashboardModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "AUDIT EXCEPTIONS";

}

@{
    // var permissionsClaim = User.FindFirst("Permissions")?.Value;
    // var permissions = string.IsNullOrEmpty(permissionsClaim)
    //     ? new List<string>()
    //     : System.Text.Json.JsonSerializer.Deserialize<List<string>>(permissionsClaim) ?? new List<string>();
    var permissions = PermissionHelper.GetPermissions(Context);

    var leftActions = new List<ComponentAction>
    {
        new ComponentAction {
            ActionKey = ActionKey.AuditHome.GetDescription(), 
            Icon = "mdi mdi-home-outline", 
            Tooltip = ILocalize.GetLocalizedLabel("App.Label.Home")
        }
    };


    if (permissions.Contains("CANVIEWCOMPLIANCEREPORTS"))
    {
        leftActions.Add(new ComponentAction { ActionKey = ActionKey.Separator.GetDescription() });
        leftActions.Add(new ComponentAction
                {
                    ActionKey = ActionKey.ExportToExcel.GetDescription(),
                    Icon = "mdi mdi-file-excel-outline",
                    Tooltip = ILocalize.GetLocalizedLabel("App.Label.Export")
                });
    }

    var component = new PageComponentViewModel
    {
        ComponentId = $"0",
        ComponentKey = "Audit.Types",
        LeftActions = leftActions
    };
}

@await Component.InvokeAsync("BaseComponent", new { model = component, content = Component.InvokeAsync("AuditExceptionList") })