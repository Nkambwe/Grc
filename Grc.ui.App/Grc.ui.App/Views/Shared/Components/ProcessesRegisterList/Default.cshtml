@model PolicyRegisterViewModel
 <div class="grc-tabulator-container"> 
     <div id="processRegisterTable"></div> 
 </div>

<!-- Overlay -->
<div id="processOverlay" class="law-panel-overlay"></div>

<!-- Process Panel -->
<div id="processPanel" class="law-side-panel" onclick="event.stopPropagation()">

    <div class="law-side-panel-header">
        <h5 id="processTitle">
            @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Audits Report.Header"))
        </h5>
        <button class="panel-close" onclick="closeProcessPanel()">
            <i class="mdi mdi-close"></i>
        </button>
    </div>

    <div class="law-side-panel-body p-0">

        <form id="processForm" class="grc-law-form">
            <input type="hidden" id="processId" name="processId">
            <input type="hidden" id="isEdit" name="isEdit">

            <!-- Tabs header -->
            <ul class="nav nav-tabs" id="reportTabs" role="tablist">

                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab">
                        PROCESS DETAILS
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="exceptions-tab" data-bs-toggle="tab" data-bs-target="#review" type="button" role="tab">
                        PROCESS REVIEW
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="controls-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab">
                        FILES/DOCUMENTS
                    </button>
                </li>

            </ul>

            <div class="tab-content">

                <div class="tab-pane fade show active" id="details" role="tabpanel">

                    <div class="row">

                        <div class="col-12"> 

                            <div class="tab-page-content">

                                <div class="tab-page-content-inner">

                                    <div class="row">

                                        <div id="lockProcess" class="col-6" @*require-permission="CANLOCKPROCESS"*@ >
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="isLockProcess">
                                                        <label class="form-check-label" for="isLockProcess">
                                                            Lock Process (This renders the document readonly)
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div id="IsDeletedBox" class="col-6" @*require-permission="CANDELETEPROCESS"*@ >
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="isDeleted">
                                                        <label class="form-check-label" for="isDeleted">
                                                            Mark Process as Deleted
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="documentName" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Name"))
                                                </label>
                                                <div class="col-12">
                                                    <input type="text" id="processName" name="processName" class="form-control" onkeypress="return validateProcessNameInput(event)" onpaste="handleProcessNamePaste(event)">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="processDescription" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Description"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="processDescription" name="processDescription" class="form-control" rows="3" onkeypress="return validateProcessDescriptionInput(event)" onpaste="handleProcessDescriptionPaste(event)"></textarea>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="processStatus" class="col-sm-12 col-form-label text-sm-start">
                                                    Current Approval Status
                                                </label>
                                                <div class="col-sm-12">
                                                    <select class="js-act-is-approved form-control" id="processStatus" name="processStatus">
                                                        <option value="DRAFT">Draft</option>
                                                        <option value="UPTODATE">Uptodate</option>
                                                        <option value="UNCHANGED">Unchanged</option>
                                                        <option value="ONHOLD">On Hold</option>
                                                        <option value="PROPOSED">Proposed</option>
                                                        <option value="DUE">Due</option>
                                                        <option value="INREVIEW">In Review</option>
                                                        <option value="DORMANT">Dormant</option>
                                                        <option value="OBSOLETE">Obsolete</option>
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="typeId" class="col-sm-12 col-form-label">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Type"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <select class="js-process-type form-control" id="typeId" name="typeId">
                                                        <option value="0">@Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Type.Select"))</option>
                                                        @if (Model?.Responsibilities != null && Model.ProcessTypes.Any())
                                                        {
                                                            foreach (var resposibility in Model.ProcessTypes)
                                                            {
                                                                <option value="@resposibility.Id">@resposibility.TypeName</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3">
                                                <label for="effectiveDate" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Effectivedate"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="effectiveDate" name="effectiveDate" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="ownerId" class="col-sm-12 col-form-label">Process Owner</label>
                                                <div class="col-sm-12">
                                                    <select class="js-act-owner form-control" id="ownerId" name="ownerId">
                                                        <option value="0">Select owner...</option>
                                                        @if (Model?.Responsibilities != null && Model.Responsibilities.Any()) {
                                                            foreach (var resposibility in Model.Responsibilities) {
                                                                <option value="@resposibility.Id">@resposibility.ResponsibleRole</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="unitId" class="col-sm-12 col-form-label">Operations Unit Responsible</label>
                                                <div class="col-sm-12">
                                                    <select class="js-act-owner form-control" id="unitId" name="unitId">
                                                        <option value="0">Select unit...</option>
                                                        @if (Model?.OperationUnits != null && Model.OperationUnits.Any())
                                                        {
                                                            foreach (var resposibility in Model.OperationUnits)
                                                            {
                                                                <option value="@resposibility.Id">@resposibility.UnitName</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="assigneedId" class="col-sm-12 col-form-label">Person Responsible For Process</label>
                                                <div class="col-sm-12">
                                                    <select class="js-act-owner form-control" id="assigneedId" name="assigneedId">
                                                        <option value="0">Select responsible...</option>
                                                        @if (Model?.Responsibilities != null && Model.Responsibilities.Any())
                                                        {
                                                            foreach (var resposibility in Model.Responsibilities)
                                                            {
                                                                <option value="@resposibility.Id">@resposibility.ResponsibleRole</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsBranchOperations">
                                                        <label class="form-check-label" for="needsBranchOperations">
                                                            Requires Branch Operations Manager Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsCreditReview">
                                                        <label class="form-check-label" for="needsCreditReview">
                                                            Requires Credit Department Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsTreasuryReview">
                                                        <label class="form-check-label" for="needsTreasuryReview">
                                                            Requires Treasury Department Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsFintechReview">
                                                        <label class="form-check-label" for="needsFintechReview">
                                                            Requires Fintech Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="comments" class="col-sm-12 col-form-label text-sm-start">
                                                    Process Comment
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="comments" name="comments" class="form-control" rows="3" onkeypress="return validateCommentInput(event)" onpaste="handleCommentPaste(event)"></textarea>
                                                </div>
                                            </div>

                                        </div>

                                    </div>

                                </div> 

                            </div>
                        
                        </div>

                    </div>

                </div>

                <div class="tab-pane fade show" id="review" role="tabpanel">

                    <div class="row">

                        <div class="col-12">

                            <div class="tab-page-content">

                                <div class="tab-page-content-inner">

                                    <div class="row">

                                        <div class="col-6"></div>

                                        <div id="onHoldBox" class="col-12">
                                            <div class="row mb-3">
                                                <label for="onholdReason" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.OnHoldReason"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="onholdReason" name="onholdReason" class="form-control" rows="3" onkeypress="return validateOnHoldInput(event)" onpaste="handleOnHoldPaste(event)"></textarea>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="hodApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                    HOD Approval Status
                                                </label>
                                                <div class="col-sm-12">
                                                    <select class="js-act-hod-approval form-control" id="hodApprovalStatus" name="hodApprovalStatus">
                                                        <option value="PENDING">Pending</option>
                                                        <option value="Approved">Approved</option>
                                                    </select>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3">
                                                <label for="hodApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                    HOD Approval Date
                                                </label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="hodApprovalOn" name="hodApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="hoApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                    HOD Approval Comments
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="hoApprovalComment" name="hoApprovalComment" class="form-control" rows="3" onkeypress="return validateHodInput(event)" onpaste="handleHodPaste(event)"></textarea>
                                                </div>
                                            </div>

                                        </div>

                                        <div id="riskBox" class="col-12">

                                            <div class="row p-0 m-0">

                                                <div class="col-6">

                                                    <div class="row mb-3">
                                                        <label for="riskApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                            Risk Approval Status
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <select class="js-act-risk-approval form-control" id="riskApprovalStatus" name="riskApprovalStatus">
                                                                <option value="PENDING">Pending</option>
                                                                <option value="Approved">Approved</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-6">
                                                    <div class="row mb-3">
                                                        <label for="riskApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                            Risk Approval Date
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <input type="text" id="riskApprovalOn" name="riskApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-12">

                                                    <div class="row mb-3">
                                                        <label for="riskApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                            Risk Approval Comments
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <textarea id="riskApprovalComment" name="riskApprovalComment" class="form-control" rows="3" onkeypress="return validateApprovalInput(event)" onpaste="handleApprovalPaste(event)"></textarea>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div id="compBox" class="col-12">

                                            <div class="row p-0 m-0">

                                                <div class="col-6">

                                                    <div class="row mb-3">
                                                            <label for="complianceApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                            Compliance Approval Status
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <select class="js-act-comp-approval form-control" id="complianceApprovalStatus" name="complianceApprovalStatus">
                                                                <option value="PENDING">Pending</option>
                                                                <option value="Approved">Approved</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-6">
                                                    <div class="row mb-3">
                                                        <label for="complianceApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                            Compliance Approval Date
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <input type="text" id="complianceApprovalOn" name="complianceApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-12">

                                                    <div class="row mb-3">
                                                        <label for="complianceApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                            Compliance Approval Comments
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <textarea id="complianceApprovalComment" name="complianceApprovalComment" class="form-control" rows="3" onkeypress="return validateComplianceInput(event)" onpaste="handleCompliancePaste(event)"></textarea>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div id="branchBox" class="col-12">

                                            <div class="row p-0 m-0">   

                                                <div class="col-6">

                                                    <div class="row mb-3">
                                                        <label for="branchOpsApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                            Branch Operations Manager Approval Status
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <select class="js-bop-approval form-control" id="branchOpsApprovalStatus" name="branchOpsApprovalStatus">
                                                                <option value="PENDING">Pending</option>
                                                                <option value="Approved">Approved</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-6">
                                                    <div class="row mb-3">
                                                        <label for="branchOpsApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                            Branch Operations Manager  Approval Date
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <input type="text" id="branchOpsApprovalOn" name="branchOpsApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="row mb-3">
                                                        <label for="branchOpsApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                            Branch Operations Manager Approval Comments
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <textarea id="branchOpsApprovalComment" name="branchOpsApprovalComment" class="form-control" rows="3" onkeypress="return validateBranchOpsInput(event)" onpaste="handleBranchOpsPaste(event)"></textarea>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div id="creditBox" class="col-12">

                                            <div class="row p-0 m-0">

                                                <div class="col-6">

                                                    <div class="row mb-3">
                                                        <label for="creditApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                            Credit Approval Status
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <select class="js-credit-approval form-control" id="creditApprovalStatus" name="creditApprovalStatus">
                                                                <option value="PENDING">Pending</option>
                                                                <option value="Approved">Approved</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-6">
                                                    <div class="row mb-3">
                                                        <label for="creditApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                            Credit Approval Date
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <input type="text" id="creditApprovalOn" name="creditApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="row mb-3">
                                                        <label for="creditApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                            Credit Approval Comments
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <textarea id="creditApprovalComment" name="creditApprovalComment" class="form-control" rows="3" onkeypress="return validateCreditInput(event)" onpaste="handleCreditPaste(event)"></textarea>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div id="treasuryBox" class="col-12">

                                            <div class="row p-0 m-0">

                                                <div class="col-6">

                                                    <div class="row mb-3">
                                                        <label for="treasuryApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                            Treasury Department Approval Status
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <select class="js-reasury-approval form-control" id="treasuryApprovalStatus" name="treasuryApprovalStatus">
                                                                <option value="PENDING">Pending</option>
                                                                <option value="Approved">Approved</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-6">
                                                    <div class="row mb-3">
                                                        <label for="treasuryApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                            Treasury Department Approval Date
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <input type="text" id="treasuryApprovalOn" name="treasuryApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-12">
                                                    <div class="row mb-3">
                                                        <label for="treasuryApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                            Treasury Department Approval Comments
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <textarea id="treasuryApprovalComment" name="treasuryApprovalComment" class="form-control" rows="3" onkeypress="return validateTreasuryInput(event)" onpaste="handleTreasuryPaste(event)"></textarea>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                        <div id="fintechBox" class="col-12">

                                            <div class="row p-0 m-0">

                                                <div class="col-6">

                                                    <div class="row mb-3">
                                                        <label for="fintechApprovalStatus" class="col-sm-12 col-form-label text-sm-start">
                                                            Fintech Approval Status
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <select class="js-reasury-approval form-control" id="fintechApprovalStatus" name="fintechApprovalStatus">
                                                                <option value="PENDING">Pending</option>
                                                                <option value="APPROVED">Approved</option>
                                                            </select>
                                                        </div>
                                                    </div>

                                                </div>

                                                <div class="col-6">
                                                    <div class="row mb-3">
                                                        <label for="fintechApprovalOn" class="col-sm-12 col-form-label text-sm-start">
                                                            Fintech Approval Date
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <input type="text" id="fintechApprovalOn" name="fintechApprovalOn" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="col-12">

                                                    <div class="row mb-3">
                                                        <label for="fintechApprovalComment" class="col-sm-12 col-form-label text-sm-start">
                                                            Fintech Approval Comments
                                                        </label>
                                                        <div class="col-sm-12">
                                                            <textarea id="fintechApprovalComment" name="fintechApprovalComment" class="form-control" rows="3" onkeypress="return validateFintechInput(event)" onpaste="handleFintechPaste(event)"></textarea>
                                                        </div>
                                                    </div>

                                                </div>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="tab-pane fade show" id="documents" role="tabpanel">

                    <div class="row">

                        <div class="col-12">

                            <div class="tab-page-content">

                                <div class="tab-page-content-inner">

                                    <div class="row">

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="fileName" class="col-sm-12 col-form-label text-sm-start">
                                                    Process File Path
                                                </label>
                                                <div class="col-12">
                                                    <input type="text" id="fileName" name="fileName" class="form-control">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="fileVersion" class="col-sm-12 col-form-label text-sm-start">
                                                    Current File Version
                                                </label>
                                                <div class="col-12">
                                                    <input type="text" id="fileVersion" name="fileVersion" class="form-control">
                                                </div>
                                            </div>
                                        </div>

