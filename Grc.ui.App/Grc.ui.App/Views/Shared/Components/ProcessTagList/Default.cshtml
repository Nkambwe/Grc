@{
    // var permissionsClaim = User.FindFirst("Permissions")?.Value;
    // var permissions = string.IsNullOrEmpty(permissionsClaim) ? new List<string>()
    // : JsonSerializer.Deserialize<List<string>>(permissionsClaim);

    var permissions = PermissionHelper.GetPermissions(Context);
}

<div class="grc-tabulator-container">

    <div class="grc-permission-alert" id="permissionAlert" style="display: none;">
        <span><i class="mdi mdi-alert-circle"></i></span>
        <span>Access Denied! You do not have permissions to view these records</span>
    </div>

    <div id="processTagTable"></div>

</div>

<!-- Overlay -->
<div id="processTagOverlay" class="permission-set-overlay"></div>

<!-- Slide Panel -->
<div id="processTagPanel" class="permission-set-panel" onclick="event.stopPropagation()">

    <div class="circular-side-panel-header">
        <h5 id="tagPanelTitle">Process Tag</h5>
        <button class="panel-close" onclick="closeProcessTagPanel()">
            <i class="mdi mdi-close"></i>
        </button>
    </div>

    <div class="permission-set-panel-body">

        <form id="processTagForm" class="grc-form row g-3 p-3">
            <input type="hidden" id="tagId">
            <input type="hidden" id="isEdit">

            <div class="col-sm-6">
                <div class="row mb-3">
                    <label for="tagName" class="col-sm-12 col-form-label text-sm-start">
                        @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.TagName"))
                    </label>
                    <div class="col-sm-12">
                        <input type="text" id="tagName" name="tagName" class="form-control" onkeypress="return validateTagNameInput(event)" onpaste="handleTagNamePaste(event)">
                    </div>
                </div>
            </div>

            <div id="IsDeletedBox" class="col-6 p-5">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="isDeleted">
                    <label class="form-check-label" for="isDeleted">
                        @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.IsDeleted"))
                    </label>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="row mb-3">
                    <label for="tagDescription" class="col-sm-12 col-form-label text-sm-start">
                        @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.TagpDescription"))
                    </label>
                    <div class="col-sm-12">
                        <textarea id="tagDescription" name="tagDescription" class="form-control" rows="3" onkeypress="return validateTagDescrInput(event)" onpaste="handleTagDescrPaste(event)"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-sm-12 permission-list-section">
                <div id="tagListContainer" class="permission-setList-container"></div>
            </div>

            <!-- Button section -->
            <div class="col-sm-12">
                <div class="row mb-3">
                    <div class="col-sm-1">
                        <button class="btn btn-grc-primary" style="width:100%;" onclick="saveProcessTagRecord(event)">@Html.Raw(ILocalize.GetLocalizedLabel("Button.Submit"))</button>
                    </div>
                    <div class="col-sm-1">
                        <button class="btn btn-grc-secondary" style="width:100%;" onclick="closeProcessTagPanel()">@Html.Raw(ILocalize.GetLocalizedLabel("Button.Cancel"))</button>
                    </div>
                    <div class="col-sm-10"></div>
                </div>
            </div>

        </form>

    </div>

</div>

@{
    Html.AddScriptParts(ResourceLocation.Footer, "~/lib/jquery/dist/jquery.js");
    Html.AddScriptParts(ResourceLocation.Footer, "~/js/app-processes-tags.js");
}

<script>
    //..make permissions available globally
    window.userPermissions = @Html.Raw(JsonSerializer.Serialize(permissions ?? new List<string>()));

</script>
