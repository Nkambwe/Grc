@model OperationsDashboardModel
@{
    // var permissionsClaim = User.FindFirst("Permissions")?.Value;
    // var permissions = string.IsNullOrEmpty(permissionsClaim) ? new List<string>()
    // : JsonSerializer.Deserialize<List<string>>(permissionsClaim);

    var permissions = PermissionHelper.GetPermissions(Context);
}

<div class="grc-tabulator-container">

    <div class="grc-permission-alert" id="permissionAlert" style="display: none;">
        <span><i class="mdi mdi-alert-circle"></i></span>
        <span>Access Denied! You do not have permissions to view these records</span>
    </div>

    <div class="grc-tabulator-search">

        <div class="field-search-buttons">
            <button id="btnReviewExport" class="btn btn-primary">
                <i class="mdi mdi-file-excel-outline"></i> @Html.Raw(ILocalize.GetLocalizedLabel("App.Label.ExportFiltered"))
            </button>
        </div>

    </div>

    <div id="processReviewTable"></div>

</div>

<!-- Overlay -->
<div id="revOverlay" class="permission-set-overlay" style="z-index:1040!important;"></div>

<!-- Process Panel -->
<div id="collapsePanel" class="law-side-panel" onclick="event.stopPropagation()">

    <div class="law-side-panel-header">
        <h5 id="processTitle">
            PROCESS REVIEW
        </h5>
        <button class="panel-close" onclick="closeReviewPanel()">
            <i class="mdi mdi-close"></i>
        </button>
    </div>

    <div class="law-side-panel-body p-0">

        <form id="processForm" class="grc-law-form">
            <input type="hidden" id="id" name="id">
            <input type="hidden" id="processId" name="processId">

            <!-- Tabs header -->
            <ul class="nav nav-tabs" id="reportTabs" role="tablist">

                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab">
                        PROCESS DETAILS
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="approvals-tab" data-bs-toggle="tab" data-bs-target="#approvals" type="button" role="tab">
                        APPROVAL PROCESS
                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="controls-tab" data-bs-toggle="tab" data-bs-target="#documents" type="button" role="tab">
                        FILES/DOCUMENTS
                    </button>
                </li>

            </ul>

            <div class="tab-content">

                <div class="tab-pane fade show active" id="details" role="tabpanel">

                    <div class="row">

                        <div class="col-12">

                            <div class="tab-page-content">

                                <div class="tab-page-content-inner">

                                    <div class="row">

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="processName" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Name"))
                                                </label>
                                                <div class="col-12">
                                                    <input type="text" id="processName" name="processName" class="form-control" readonly/>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="processDescription" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Description"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="processDescription" name="processDescription" class="form-control" rows="3" readonly></textarea>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="processType" class="col-sm-12 col-form-label">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Type"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="processType" name="processType" class="form-control" readonly>
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3">
                                                <label for="effectiveDate" class="col-sm-12 col-form-label text-sm-start">
                                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Effectivedate"))
                                                </label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="effectiveDate" name="effectiveDate" class="form-control datepicker" placeholder="MM/DD/YYYY" />
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="ownerName" class="col-sm-12 col-form-label">Process Owner</label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="ownerName" name="ownerName" class="form-control" readonly />
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="unitName" class="col-sm-12 col-form-label">Operations Unit Responsible</label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="unitName" name="unitName" class="form-control" readonly />
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">

                                            <div class="row mb-3">
                                                <label for="assigneeName" class="col-sm-12 col-form-label">Person Responsible For Process</label>
                                                <div class="col-sm-12">
                                                    <input type="text" id="assigneeName" name="assigneeName" class="form-control" readonly />
                                                </div>
                                            </div>

                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsBranchOperations">
                                                        <label class="form-check-label" for="needsBranchOperations">
                                                            Requires Branch Operations Manager Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsCreditReview">
                                                        <label class="form-check-label" for="needsCreditReview">
                                                            Requires Credit Department Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsTreasuryReview">
                                                        <label class="form-check-label" for="needsTreasuryReview">
                                                            Requires Treasury Department Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-6">
                                            <div class="row mb-3 p-3">
                                                <div class="col-12">
                                                    <div class="form-check">
                                                        <input class="form-check-input" type="checkbox" id="needsFintechReview">
                                                        <label class="form-check-label" for="needsFintechReview">
                                                            Requires Fintech Approval
                                                        </label>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="comments" class="col-sm-12 col-form-label text-sm-start">
                                                    Process Comment
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="comments" name="comments" class="form-control" rows="3" readonly></textarea>
                                                </div>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="tab-pane fade" id="approvals" role="tabpanel">

                    <!-- HOD Section -->
                    <div id="hodSection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Hod"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="hodStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="hodStatus" name="hodStatus" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="hodComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="hodComment" name="hodComment" class="form-control" rows="3" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>
                    
                    <!-- Risk Section -->
                    <div id="riskSection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Risk"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="riskStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="riskStatus" name="riskStatus" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="riskComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="riskComment" name="riskComment" class="form-control" rows="3" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Compliance Section -->
                    <div id="complianceSection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Compliance"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="complianceStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="complianceStatus" name="complianceStatus" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="complianceComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="complianceComment" name="complianceComment" class="form-control" rows="3" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Branch Operations Section -->
                    <div id="bopSection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Bop"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="bopStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="bopStatus" name="bopStatus" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="bopComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="bopComment" name="bopComment" class="form-control" rows="3" class="form-control" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Treasury Section -->
                    <div id="treasurySection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Treasury"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">

                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="treasuryStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="treasuryStatus" name="treasuryStatus" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="treasuryComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="treasuryComment" name="treasuryComment" class="form-control" rows="3" class="form-control" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Credit Section -->
                    <div id="creditSection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Fintech"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">

                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="creditStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="creditStatus" name="creditStatus" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="creditComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="creditComment" name="creditComment" class="form-control" rows="3" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                    <!-- Fintech Section -->
                    <div id="fintechSection" class="form-section">

                        <div class="section-header" onclick="toggleSection(this)">
                            <h5>@Html.Raw(ILocalize.GetLocalizedLabel("Component.Process.CollapsablePane.Credit"))</h5>
                            <span class="section-toggle">
                                <i class="mdi mdi-menu-down"></i>
                            </span>
                        </div>

                        <div class="section-content">

                            <div class="section-body">

                                <div class="row g-3">
                                    <div class="col-6">
                                        <div class="row mb-3">
                                            <label for="fintechStatus" class="col-sm-12 form-label">
                                                Approval Status
                                            </label>
                                            <div class="col-sm-12">
                                                <input id="fintechStatus" name="fintechStatus" class="form-control" readonly />
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="row mb-3">
                                            <label for="fintechComment" class="col-sm-12 form-label">
                                                @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Comments"))
                                            </label>
                                            <div class="col-sm-12">
                                                <textarea id="fintechComment" name="fintechComment" class="form-control" rows="3" readonly></textarea>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>

                </div>

                <div class="tab-pane fade show" id="documents" role="tabpanel">

                    <div class="row">

                        <div class="col-12">

                            <div class="tab-page-content">

                                <div class="tab-page-content-inner">

                                    <div class="row">

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="fileName" class="col-sm-12 col-form-label text-sm-start">
                                                    Process File Path
                                                </label>
                                                <div class="col-12">
                                                    <input type="text" id="fileName" name="fileName" class="form-control">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="fileVersion" class="col-sm-12 col-form-label text-sm-start">
                                                    Current File Version
                                                </label>
                                                <div class="col-12">
                                                    <input type="text" id="fileVersion" name="fileVersion" class="form-control" onkeypress="return validateVersionInput(event)" onpaste="handleVersionPaste(event)">
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12">
                                            <div class="row mb-3">
                                                <label for="assigneeComments" class="col-sm-12 col-form-label text-sm-start">
                                                   Notes
                                                </label>
                                                <div class="col-sm-12">
                                                    <textarea id="assigneeComments" name="assigneeComments" class="form-control" rows="3" onkeypress="return validateCommentInput(event)" onpaste="handleCommentPaste(event)"></textarea>
                                                </div>
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="tab-footer p-3">
                    <div class="row mb-3">
                        <div class="col-3">
                            <button type="button" id="btnSaveReview" class="btn btn-grc-primary" style="width:100%;">
                                Save
                            </button>
                        </div>
                        <div class="col-3">
                            <button type="button" class="btn btn-grc-secondary" style="width:100%;" onclick="closeReviewPanel()">Cancle</button>
                        </div>
                        <div class="col-6"></div>
                    </div>
                </div>
            </div>

        </form>

    </div>

</div>

@{
    Html.AddScriptParts(ResourceLocation.Footer, "~/lib/jquery/dist/jquery.js");
    Html.AddScriptParts(ResourceLocation.Footer, "~/js/app-process-review-list.js");
}

<script>
    //..make permissions available globally
    window.userPermissions = @Html.Raw(JsonSerializer.Serialize(permissions ?? new List<string>()));

</script>
