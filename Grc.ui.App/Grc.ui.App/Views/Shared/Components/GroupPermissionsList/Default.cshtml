@{
    var permissionsClaim = User.FindFirst("Permissions")?.Value;
    var permissions = string.IsNullOrEmpty(permissionsClaim) ? new List<string>()
    : JsonSerializer.Deserialize<List<string>>(permissionsClaim);
}

<div class="grc-tabulator-container">
    <div class="grc-permission-alert" id="permissionAlert" style="display: none;">
        <span><i class="mdi mdi-alert-circle"></i></span>
        <span>Access Denied! You do not have permissions to view these records</span>
    </div>
    <div class="grc-error-alert" id="errorAlert" style="display: none;">
        <span><i class="mdi mdi-alert-octagon"></i></span>
        <span id="errorAlertMessage">An error occurred while loading data</span>
    </div>
    <div id="roleGroupPermissionsTable"></div>
</div>

<!-- Overlay -->
<div id="rolePermOverlay" class="permission-set-overlay"></div>

<div id="rolePermPanel" class="permission-set-panel" onclick="event.stopPropagation()">

    <div class="circular-side-panel-header">
        <h5 id="setTitle">Role Group Permissions</h5>
        <button class="panel-close" onclick="closeGroupPermissionPanel()">
            <i class="mdi mdi-close"></i>
        </button>
    </div>

    <div class="permission-set-panel-body">

        <form id="groupForm" class="grc-set-form">

            <input type="hidden" id="groupId">
            <input type="hidden" id="isEdit">

            <div class="row main-row">

                <!-- Top section - form fields -->
                <div class="col-sm-12 form-fields-section">

                    <div class="row">

                        <div class="col-6">
                            <!-- Group Name -->
                            <div class="row mb-3">
                                <label for="groupName" class="col-12 col-form-label">
                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Role.Group.Name"))
                                </label>
                                <div class="col-12">
                                    <input type="text" id="groupName" name="groupName" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <!-- group description-->
                        <div class="col-6">
                            <div class="row mb-3">
                                <label for="groupDescription" class="col-12 col-form-label">
                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Role.Group.Description"))
                                </label>
                                <div class="col-12">
                                    <input type="text" id="groupDescription" name="groupDescription" class="form-control" />
                                </div>
                            </div>
                        </div>

                        <!-- group category -->
                        <div class="col-6">
                            <div class="row mb-3">
                                <label for="groupCategory" class="col-12 form-label">
                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.Type"))
                                </label>
                                <div class="col-12">
                                    <select class="js-group-category-id form-control" id="groupCategory" name="groupCategory">
                                        <option value="NONE">Select category...</option>
                                        <option value="SYSTEM">System</option>
                                        <option value="DEVELOPER">System Developers</option>
                                        <option value="APPLICATIONSUPPORT">IT Support</option>
                                        <option value="ADMINISTRATOR">System Administrators</option>
                                        <option value="COMPLIANCEADMIN">Compliance Administrators</option>
                                        <option value="COMPLIANCEDEPT">Compliance Users</option>
                                        <option value="COMPLIANCEGUESTS">Compliance External Users</option>
                                        <option value="OPERATIONADMIN">Operations Administrators</option>
                                        <option value="OPERATIONSERVICES">Operations Users</option>
                                        <option value="OPERATIONGUESTS">Operations External Users</option>
                                    </select>

                                    <span id="hodStatus-description" class="sr-only">
                                        @Html.Raw(ILocalize.GetLocalizedLabel("App.Label.srOnly.ArrowKeys"))
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-6 d-flex">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="isDeleted" name="isDeleted">
                                <label class="form-check-label" for="isDeleted">
                                    @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Role.Group.Deleted"))
                                </label>
                            </div>
                        </div>

                    </div>

                </div>

                <!-- Middle section - permission list -->
                <div class="col-sm-12 permission-list-section">
                    <div id="roleGroupListContainer" class="permission-setList-container"></div>
                </div>

                <!-- Bottom section - buttons -->
                <div class="col-sm-12 button-section">
                    <div class="row mb-3">
                        <div class="col-sm-1">
                            <button class="btn btn-grc-primary w-100" onclick="saveGroupPermissions(event)">
                                @Html.Raw(ILocalize.GetLocalizedLabel("Button.Submit"))
                            </button>
                        </div>
                        <div class="col-sm-1">
                            <button class="btn btn-grc-secondary w-100" onclick="closeGroupPermissionPanel()">
                                @Html.Raw(ILocalize.GetLocalizedLabel("Button.Cancel"))
                            </button>
                        </div>
                        <div class="col-sm-10"></div>
                    </div>
                </div>
            </div>

        </form>

    </div>

</div>

@{
    Html.AddScriptParts(ResourceLocation.Footer, "~/lib/jquery/dist/jquery.js");
    Html.AddScriptParts(ResourceLocation.Footer, "~/js/admin-rolegroup-permissions.js");
}

<script>
    //..make permissions available globally
    window.userPermissions = @Html.Raw(JsonSerializer.Serialize(permissions ?? new List<string>()));

</script>

