@{
    var permissionsClaim = User.FindFirst("Permissions")?.Value;
    var permissions = string.IsNullOrEmpty(permissionsClaim) ? new List<string>()
    : JsonSerializer.Deserialize<List<string>>(permissionsClaim);
}

<div class="grc-tabulator-container">
    <div class="grc-permission-alert" id="permissionAlert" style="display: none;">
        <span><i class="mdi mdi-alert-circle"></i></span>
        <span>Access Denied! You do not have permissions to view these records</span>
    </div>
    <div class="grc-error-alert" id="errorAlert" style="display: none;">
        <span><i class="mdi mdi-alert-octagon"></i></span>
        <span id="errorAlertMessage">An error occurred while loading data</span>
    </div>
    <div id="category-table"></div>

</div>

<!-- Overlay -->
<div id="catOverlay" class="obligation-panel-overlay" onclick="closeRegulatoryCategoryPanel()"></div>

<!-- Slide Panel -->
<div id="slidePanel" class="obligation-side-panel" onclick="event.stopPropagation()">

    <div class="panel-header">
        <h3 id="panelTitle">@Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Category.Header"))</h3>
        <button class="panel-close" onclick="closeRegulatoryCategoryPanel()">
            <i class="mdi mdi-close"></i>
        </button>
    </div>

    <div class="obligation-side-panel-body">

        <form id="recordForm" class="grc-form row g-3 m-3">
            <input type="hidden" id="recordId">
            <input type="hidden" id="isEdit">

            <div class="col-12">
                <div class="row field-group">
                    <label for="categoryName" class="form-label text-right  col-12">@Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Category.Header"))</label>
                    <input type="text" id="categoryName" name="categoryName" class="form-control col-12"  onkeypress="return validateCategoryInput(event)" onpaste="handleCategoryPaste(event)">
                </div>
            </div>

            <div class="col-6">
                <div class="row field-group mt-5 mb-5">
                    <div id="isActive" class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isActive">
                            <label class="form-check-label" for="isActive">Remove Category from list</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-3">
                <div class="mb-3">
                    <label for="comments" class="form-label">Comment</label>
                    <textarea class="form-control" id="comments" rows="3" onkeypress="return validateCategoryCommentInput(event)" onpaste="handleCategoryCommentPaste(event)"></textarea>
                </div>
            </div>

            <div class="col-12">
                <div class="row mb-3">
                    <div class="col-3">
                        <button class="btn btn-grc-primary" style="width:100%;" onclick="saveRegulatoryCategoryRecord(event)">@Html.Raw(ILocalize.GetLocalizedLabel("Button.Submit"))</button>
                    </div>
                    <div class="col-3">
                        <button class="btn btn-grc-secondary" style="width:100%;" onclick="closeRegulatoryCategoryPanel()">@Html.Raw(ILocalize.GetLocalizedLabel("Button.Cancel"))</button>
                    </div>
                    <div class="col-6"></div>
                </div>
            </div>

        </form>
    </div>

</div>

@{
    Html.AddScriptParts(ResourceLocation.Footer, "~/lib/jquery/dist/jquery.js");
    Html.AddScriptParts(ResourceLocation.Footer, "~/js/app-regulation-categories.js");

}

<script>
    //..make permissions available globally
    window.userPermissions = @Html.Raw(JsonSerializer.Serialize(permissions ?? new List<string>()));

</script>


