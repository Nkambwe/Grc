<div class="grc-tabulator-container">

    <div id="processGroupTable"></div>

</div>

<!-- Overlay -->
<div id="processTagOverlay" class="permission-set-overlay"></div>

<!-- Slide Panel -->
<div id="processTagPanel" class="permission-set-panel" onclick="event.stopPropagation()">

    <div class="circular-side-panel-header">
        <h5 id="groupPanelTitle">Process Group</h5>
        <button class="panel-close" onclick="closeProcessGroupPanel()">
            <i class="mdi mdi-close"></i>
        </button>
    </div>

    <div class="permission-set-panel-body">

        <form id="processGroupForm" class="grc-form row g-3 p-3">
            <input type="hidden" id="groupId">
            <input type="hidden" id="isEdit">

            <div class="col-sm-6">
                <div class="row mb-3">
                    <label for="groupName" class="col-sm-12 col-form-label text-sm-start">
                        @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.GroupName"))
                    </label>
                    <div class="col-sm-12">
                        <input type="text" id="groupName" name="groupName" class="form-control" onkeypress="return validateGroupNameInput(event)" onpaste="handleGroupNamePaste(event)">
                    </div>
                </div>
            </div>

            <div id="IsDeletedBox" class="col-6 p-5">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="isDeleted">
                    <label class="form-check-label" for="isDeleted">
                        @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.IsDeleted"))
                    </label>
                </div>
            </div>

            <div class="col-sm-12">
                <div class="row mb-3">
                    <label for="groupDescription" class="col-sm-12 col-form-label text-sm-start">
                        @Html.Raw(ILocalize.GetLocalizedLabel("Component.Table.Process.GroupDescription"))
                    </label>
                    <div class="col-sm-12">
                        <textarea id="groupDescription" name="groupDescription" class="form-control" rows="3" onkeypress="return validateGroupDescrInput(event)" onpaste="handleGroupDescrPaste(event)"></textarea>
                    </div>
                </div>
            </div>

            <div class="col-sm-12 permission-list-section">
                <div id="groupListContainer" class="permission-setList-container"></div>
            </div>

            <!-- Button section -->
            <div class="col-sm-12">
                <div class="row mb-3">
                    <div class="col-sm-1">
                        <button class="btn btn-grc-primary" style="width:100%;" onclick="saveProcessGroupRecord(event)">@Html.Raw(ILocalize.GetLocalizedLabel("Button.Submit"))</button>
                    </div>
                    <div class="col-sm-1">
                        <button class="btn btn-grc-secondary" style="width:100%;" onclick="closeProcessGroupPanel()">@Html.Raw(ILocalize.GetLocalizedLabel("Button.Cancel"))</button>
                    </div>
                    <div class="col-sm-10"></div>
                </div>
            </div>

        </form>

    </div>
</div>


@{
    Html.AddScriptParts(ResourceLocation.Footer, "~/lib/jquery/dist/jquery.js");
    Html.AddScriptParts(ResourceLocation.Footer, "~/js/app-processes-groups.js");
}