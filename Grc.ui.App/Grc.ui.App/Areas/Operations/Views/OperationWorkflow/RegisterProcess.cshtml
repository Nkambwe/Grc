@using System.Text.Json
@model OperationsDashboardModel
@{
    Layout = "_OperationLayout";
    ViewData["Title"] = "POROCESS REGISTER";
}

@{
    
    var permissionsClaim = User.FindFirst("Permissions")?.Value;
    var permissions = string.IsNullOrEmpty(permissionsClaim)
        ? new List<string>()
        : System.Text.Json.JsonSerializer.Deserialize<List<string>>(permissionsClaim) ?? new List<string>();

    var leftActions = new List<ComponentAction> {
        new ComponentAction {
            ActionKey = ActionKey.OpsHome.GetDescription(),
            Icon = "mdi mdi mdi-home-outline",
            Tooltip = ILocalize.GetLocalizedLabel("App.Label.Home")
        }
    };

    if (permissions.Contains("CreateOperationProcesses"))
    {
        leftActions.Add(new ComponentAction { ActionKey = ActionKey.Separator.GetDescription()});
        leftActions.Add(new ComponentAction {
            ActionKey = ActionKey.ProcessNew.GetDescription(),
            Icon = "mdi mdi-plus",
            Tooltip = ILocalize.GetLocalizedLabel("App.Label.New")
        });
    }
    
    if (permissions.Contains("CANDOWNLOADPROCESSREPORT")) {
        leftActions.Add(new ComponentAction { ActionKey = ActionKey.Separator.GetDescription()});
        leftActions.Add(new ComponentAction {
            ActionKey = ActionKey.ExportActivityExcelToExcel.GetDescription(),
            Icon = "mdi mdi mdi-download",
            Tooltip = "Export to Excel"
        });
    }

    var component = new PageComponentViewModel {
        ComponentId = $"0",
        ComponentKey = "Universe",
        LeftActions = leftActions
    };
}

@await Component.InvokeAsync("BaseComponent", new { model = component, content = Component.InvokeAsync("ProcessesRegisterList") })